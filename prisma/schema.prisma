generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String?
  email        String        @unique
  image        String?
  comments     Comment[]
  likes        Like[]
  chatSessions ChatSession[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("users")
}

model ChatSession {
  id        String        @id @default(cuid())
  title     String?
  userId    String        @map("user_id")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String      @map("session_id")
  sender    String
  text      String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("chat_messages")
}

model Like {
  id        String   @id @default(cuid())
  postSlug  String   @map("post_slug")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([postSlug, userId])
  @@index([postSlug])
  @@map("likes")
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  userId    String?  @map("user_id")
  sessionId String   @map("session_id")
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([path])
  @@index([sessionId])
  @@index([ip])
  @@map("page_views")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model Subscriber {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String?
  verified   Boolean  @default(false)
  token      String   @unique @default(cuid())
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("subscribers")
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  postSlug  String    @map("post_slug")
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String    @map("author_id")
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId  String?   @map("parent_id")
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([postSlug])
  @@index([authorId])
  @@index([parentId])
  @@map("comments")
}

model MailboxSecret {
  name      String   @id
  secret    String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("mailbox_secrets")
}

model Campaign {
  id             String          @id @default(cuid())
  slug           String          @unique
  title          String
  body           String
  mediaUrl       String?         @map("media_url")
  mediaType      String          @default("none") @map("media_type")
  channels       String[]        @default([])
  goal           String          @default("web")
  webUrl         String?         @map("web_url")
  iosUrl         String?         @map("ios_url")
  androidUrl     String?         @map("android_url")
  whatsappNumber String?         @map("whatsapp_number")
  whatsappText   String?         @map("whatsapp_text")
  formUrl        String?         @map("form_url")
  utmSource      String          @default("meta") @map("utm_source")
  utmMedium      String          @default("social") @map("utm_medium")
  utmCampaign    String?         @map("utm_campaign")
  status         String          @default("draft")
  scheduledAt    DateTime?       @map("scheduled_at")
  publishedAt    DateTime?       @map("published_at")
  fbPostId       String?         @map("fb_post_id")
  igMediaId      String?         @map("ig_media_id")
  lastError      String?         @map("last_error")
  clicks         CampaignClick[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([status])
  @@map("campaigns")
}

model WaInstance {
  id          String   @id @default(cuid())
  instanceId  String   @unique @map("instance_id")
  name        String
  phoneNumber String?  @map("phone_number")
  apps        String[] @default([])
  channel     String   @default("baileys")
  status      String   @default("created")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("wa_instances")
}

model CampaignClick {
  id         String   @id @default(cuid())
  campaignId String   @map("campaign_id")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  at         DateTime @default(now())
  device     String
  channel    String?
  country    String?
  referer    String?
  ipHash     String?  @map("ip_hash")

  @@index([campaignId, at])
  @@map("campaign_clicks")
}
