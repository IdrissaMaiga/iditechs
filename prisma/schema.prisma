generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String?
  email        String        @unique
  image        String?
  comments     Comment[]
  likes        Like[]
  chatSessions ChatSession[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("users")
}

model ChatSession {
  id        String        @id @default(cuid())
  title     String?
  userId    String        @map("user_id")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String      @map("session_id")
  sender    String
  text      String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("chat_messages")
}

model Like {
  id        String   @id @default(cuid())
  postSlug  String   @map("post_slug")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([postSlug, userId])
  @@index([postSlug])
  @@map("likes")
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  userId    String?  @map("user_id")
  sessionId String   @map("session_id")
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([path])
  @@index([sessionId])
  @@index([ip])
  @@map("page_views")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model Subscriber {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String?
  verified   Boolean  @default(false)
  token      String   @unique @default(cuid())
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("subscribers")
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  postSlug  String    @map("post_slug")
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String    @map("author_id")
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId  String?   @map("parent_id")
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([postSlug])
  @@index([authorId])
  @@index([parentId])
  @@map("comments")
}

model MailboxSecret {
  name      String   @id
  secret    String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("mailbox_secrets")
}

model Campaign {
  id             String          @id @default(cuid())
  slug           String          @unique
  title          String
  body           String?
  goal           String          @default("web")
  webUrl         String?         @map("web_url")
  iosUrl         String?         @map("ios_url")
  androidUrl     String?         @map("android_url")
  whatsappNumber String?         @map("whatsapp_number")
  whatsappText   String?         @map("whatsapp_text")
  formUrl        String?         @map("form_url")
  utmMedium      String          @default("social") @map("utm_medium")
  utmCampaign    String?         @map("utm_campaign")
  listed         Boolean         @default(false)
  clicks         CampaignClick[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("campaigns")
}

model WaInstance {
  id          String   @id @default(cuid())
  instanceId  String   @unique @map("instance_id")
  name        String
  phoneNumber String?  @map("phone_number")
  tags        String[] @default([])
  channel     String   @default("baileys")
  status      String   @default("created")
  webhookUrl  String?  @map("webhook_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("wa_instances")
}

// SMS, calls and notifications forwarded from the owner's Android phone (SmsForwarder webhook)
model PhoneEvent {
  id         String   @id @default(cuid())
  kind       String // sms | call | app
  from       String
  content    String
  simInfo    String?  @map("sim_info")
  device     String?
  receivedAt DateTime @map("received_at")
  read       Boolean  @default(false)
  dedupKey   String   @unique @map("dedup_key")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([receivedAt])
  @@map("phone_events")
}

model CampaignClick {
  id         String   @id @default(cuid())
  campaignId String   @map("campaign_id")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  at         DateTime @default(now())
  device     String
  channel    String?
  country    String?
  referer    String?
  ipHash     String?  @map("ip_hash")

  @@index([campaignId, at])
  @@map("campaign_clicks")
}

// IDITECHS Pay: payment gateway for IDITECHS's own applications (lib/pay, app/api/pay). It only records money collected
// through itself; sales made through other channels (Google Play, App Store, WhatsApp) are counted by each application.
model PayApp {
  id            String       @id
  name          String
  apiKeyHash    String       @unique @map("api_key_hash")
  apiKeyPrefix  String       @map("api_key_prefix")
  webhookUrl    String?      @map("webhook_url")
  webhookSecret String       @map("webhook_secret")
  active        Boolean      @default(true)
  payments      Payment[]
  deliveries    PayDelivery[]
  createdAt     DateTime     @default(now()) @map("created_at")

  @@map("pay_apps")
}

model Payment {
  id           String         @id
  appId        String         @map("app_id")
  app          PayApp         @relation(fields: [appId], references: [id])
  // The app's own order id; one payment per (app, reference)
  reference    String
  provider     String
  // Smallest unit of the currency (FCFA for XOF)
  amount       Int
  currency     String
  description  String         @default("")
  status       String         @default("pending")
  // Money given back after a success: refunds so far, and the card dispute (chargeback) if any
  amountRefunded Int          @default(0) @map("amount_refunded")
  disputeStatus  String?      @map("dispute_status")
  disputeAmount  Int          @default(0) @map("dispute_amount")
  providerRef  String?        @map("provider_ref")
  // Provider tokens (Orange pay_token/notif_token...), never returned by the API
  providerData Json           @default("{}") @map("provider_data")
  checkoutUrl  String?        @map("checkout_url")
  returnUrl    String         @map("return_url")
  cancelUrl    String?        @map("cancel_url")
  customer     Json           @default("{}")
  metadata     Json           @default("{}")
  events       PaymentEvent[]
  deliveries   PayDelivery[]
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  completedAt  DateTime?      @map("completed_at")

  @@unique([appId, reference])
  @@index([provider, providerRef])
  @@map("pay_payments")
}

model PaymentEvent {
  id        BigInt   @id @default(autoincrement())
  paymentId String   @map("payment_id")
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  source    String
  type      String
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([paymentId])
  @@map("pay_events")
}

model PayDelivery {
  id            BigInt    @id @default(autoincrement())
  paymentId     String    @map("payment_id")
  payment       Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  appId         String    @map("app_id")
  app           PayApp    @relation(fields: [appId], references: [id])
  eventType     String    @map("event_type")
  body          String
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  lastStatus    Int?      @map("last_status")
  lastError     String?   @map("last_error")
  deliveredAt   DateTime? @map("delivered_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([nextAttemptAt])
  @@map("pay_deliveries")
}
